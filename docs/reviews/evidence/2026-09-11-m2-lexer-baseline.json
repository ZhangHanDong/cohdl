  "harness_source": "use cohdl::{span, diag, lex};\nfn main() {\n for source in std::env::args().skip(1) {\n  let mut sm = span::SourceMap::new();\n  let file = sm.add_file(\"probe.cohdl\", source.clone());\n  let mut ds = diag::Diagnostics::new();\n  let ts = lex::lex(file, &source, &mut ds);\n  println!(\"CASE\");\n  for t in ts { println!(\"TOKEN {:?} {} {}\", t.kind, t.span.start, t.span.end); }\n  for d in ds.iter() { println!(\"DIAG {} {} {} {}\", d.code, d.primary.span.start, d.primary.span.end, d.message); }\n }\n}\n",
